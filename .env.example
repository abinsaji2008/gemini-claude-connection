# Key that Claude sends to this bridge. Generate a strong, unique value.
GATEWAY_API_KEY=replace-with-a-long-random-secret

# Existing OpenAI-compatible upstream endpoint.
UPSTREAM_BASE_URL=https://api.abihomelabs.dpdns.org/v1

# Must be the REAL key accepted by your upstream API.
UPSTREAM_API_KEY=replace-with-real-upstream-key

# Defaults to Authorization: Bearer <UPSTREAM_API_KEY>.
# Uncomment and adjust only if your upstream uses a different auth header.
# UPSTREAM_AUTH_HEADER=x-api-key
# UPSTREAM_AUTH_PREFIX=
